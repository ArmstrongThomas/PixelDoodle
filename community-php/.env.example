APP_NAME="Pixel Doodle"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pixels.7db.pw
# Windows host. Suggested private data directory OUTSIDE F:/pixeldoodle webroot.
DB_CONNECTION=sqlite
DB_DATABASE=F:/pixeldoodle-data/application.sqlite
GALLERY_DATABASE=F:/pixeldoodle-data/gallery.sqlite
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=single
LOG_LEVEL=warning
# Discord OAuth sign-in. No bot permissions are requested by this provider.
DISCORD_CLIENT_ID=1560340963728294011
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://pixels.7db.pw/api/auth/callback/discord
ENABLE_DEVICE_PAIRING=false
# Artwork submissions are console-only by default; do not enable browser uploads.
WEB_UPLOADS_ENABLED=false
# Email sign-in stays off until working SMTP settings are supplied.
# PHP account services (enable only after private DB migration and HTTPS setup).
AUTH_ENABLED=false
EMAIL_ENABLED=false
# SMTP is the only enabled mail transport for codes; never log live codes.
MAIL_MAILER=smtp
MAIL_HOST=mail.7db.pw
MAIL_PORT=587
MAIL_USERNAME=pixeladmin@7db.pw
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=pixeladmin@7db.pw
MAIL_FROM_NAME="Pixel Doodle Admin"
SESSION_LIFETIME=10080



# Interactive Discord moderation bot (separate from OAuth client secret).
DISCORD_BOT_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
DISCORD_REVIEW_CHANNEL_ID=
DISCORD_MODERATOR_ROLE_IDS=
