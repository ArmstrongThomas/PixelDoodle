BLOCKSDS ?= /opt/blocksds/core
ARM7ELF := $(BLOCKSDS)/sys/arm7/main_core/arm7_dswifi.elf
NAME := PixelDoodle
GAME_TITLE := Pixel Doodle
PD_PRIVATE_BUILD ?= 0
ifeq ($(PD_PRIVATE_BUILD),1)
NAME := PixelDoodle-Private
GAME_TITLE := Pixel Doodle Private
endif
PD_VERSION := $(shell sed -n 's/^\#define PD_VERSION "\(.*\)"/\1/p' core/version.h)
GAME_SUBTITLE := Offline pixel art $(PD_VERSION)
GAME_AUTHOR := Tommy
GAME_ICON := assets/icon-nds.gif
SOURCEDIRS := core ui platform/nds vendor/zlib vendor/mbedtls/library
INCLUDEDIRS := core ui platform/nds vendor/zlib vendor/mbedtls/include data
CFLAGS := -Wall -Wextra -Werror -Wno-misleading-indentation -std=gnu11
LIBS := -ldswifi9 -lnds9 -lm
LIBDIRS := $(BLOCKSDS)/libs/dswifi
DEFINES := -DMBEDTLS_CONFIG_FILE='"pixel_doodle_mbedtls_config.h"'
ifeq ($(PD_PRIVATE_BUILD),1)
DEFINES += -DPD_PRIVATE_BUILD=1
endif
include $(BLOCKSDS)/sys/default_makefiles/rom_arm9/Makefile
